{
  "name": "codeorbit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenv -e .env -- concurrently -k -n api,worker,web \"pnpm --filter @codeorbit/api dev\" \"pnpm --filter @codeorbit/analysis-worker dev\" \"pnpm --filter @codeorbit/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "dotenv -e .env -- vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run tests/contract",
    "generate:api-types": "openapi-typescript specs/001-evidence-backed-analysis/contracts/openapi.yaml -o packages/api-contracts/src/openapi.d.ts",
    "db:migrate": "dotenv -e .env -- tsx packages/persistence/src/migrate.ts",
    "db:reset": "dotenv -e .env -- tsx packages/persistence/src/reset.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.13",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "fastify": "^5.2.2",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  }
}
